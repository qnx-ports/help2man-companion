# This can only be compiled natively on QNX
pkgname=help2man
pkgver=1.49.3
pkgrel=0
pkgdesc="Create simple man pages from --help output"
url="https://www.gnu.org/software/help2man"
arch="all"
depends="perl qnx-io-sock"
makedepends="qnx-io-sock-dev"
options="!check"
license="GPL-3.0-or-later"
subpackages="$pkgname-doc"
source="${pkgname}-${pkgver}.tar.xz::https://ftp.gnu.org/gnu/help2man/help2man-$pkgver.tar.xz"
builddir="${srcdir}/${pkgname}-${pkgver}"

build() {
    if [[ $CBUILD = $CHOST ]]; then
        # Compile natively
        echo "No additional arguments are required"
    else
        # Cross compiling
        echo "This can not be cross-compiled"
        exit 1;
    fi

   CHOST="$CHOST" \
   ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        CFLAGS=-D_QNX_SOURCE \
        LDFLAGS="-lm -lregex -lsocket -lgcc_s"

    make
}

package() {
    make DESTDIR="$pkgdir/" install
}

sha512sums="
5f19fad1e38b0572b63ed8bfd146b717fc22dff3a26641e8b5c8431df13da9574679d9a3407da62790db8a29286694ea1bfd751cba168f475302ad31cce845cf  help2man-1.49.3.tar.xz
"
